# Apache config for gssquared.net/live — deployed as /live/.htaccess by
# scripts/deploy-web.sh. Every directive here is in the FileInfo override class,
# which is what the site's vhost grants (AllowOverride FileInfo).

<IfModule mod_headers.c>
    # The build uses pthreads, so it needs SharedArrayBuffer, which browsers
    # only expose to cross-origin isolated pages. require-corp rather than
    # credentialless: Safari does not implement credentialless.
    Header set Cross-Origin-Opener-Policy "same-origin"
    Header set Cross-Origin-Embedder-Policy "require-corp"
    Header set Cross-Origin-Resource-Policy "same-origin"

    # The build products keep the same names across deploys. Cache them for a
    # day so repeat visits do not re-download the wasm. A new deploy can take
    # up to 24 hours to replace what a browser already stored.
    Header set Cache-Control "public, max-age=86400"
</IfModule>

# Apache needs this for WebAssembly.instantiateStreaming().
AddType application/wasm .wasm

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/wasm application/javascript text/html
</IfModule>
