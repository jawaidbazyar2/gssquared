# iie mmu characterization
# [cross] [reset] [video-ignored] [cxx-ignored] record $00-$BF and $D0-$FF.
# [cxx-intcx-on] [cxx-slot] [cxx-c8] [cxx-reset] [cxx-aux-ignored] record $C1-$CF.
# RAM+offset is pointer - main_ram, 17 bits (0x00000-0x1FFFF). Bit 16 set is auxiliary bank 0.
# LCWRITE=1 means RAM writes are enabled (_FF_WRITE_ENABLE == 0). LCREAD=1 means RAM reads are enabled.
# LCBANK is 1 or 2. SLOTC3=1 means slot 3 card ROM (f_slotc3rom).
# RamWorks is not recorded.
[cross]
80ST=0 RAMRD=0 RAMWRT=0 ALTZP=0 PAGE2=0 HIRES=0 LCBANK=2 LCREAD=0 LCWRITE=0 | 00-BF R RAM+0x00000 W RAM+0x00000 D0-FF R ROM+0x1000 W NONE
80ST=0 RAMRD=0 RAMWRT=0 ALTZP=0 PAGE2=0 HIRES=0 LCBANK=2 LCREAD=0 LCWRITE=1 | 00-BF R RAM+0x00000 W RAM+0x00000 D0-FF R ROM+0x1000 W RAM+0x0D000
